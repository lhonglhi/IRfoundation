# ============================================
# Intelligent Racing Foundation — GoDaddy / Apache
# ============================================

# ---- Error pages ----
ErrorDocument 401 /401.html
ErrorDocument 404 /404.html

# ---- Default index ----
DirectoryIndex index.html

# ---- Force HTTPS + non-www -> www (edit if you prefer apex) ----
RewriteEngine On

# HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Drop trailing .html from URLs (optional pretty URLs)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# ---- Gzip compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
    application/javascript application/json application/xml \
    image/svg+xml application/x-font-ttf font/woff font/woff2
</IfModule>

# ---- Browser caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  ExpiresByType text/html                     "access plus 1 hour"
  ExpiresByType text/css                      "access plus 1 month"
  ExpiresByType application/javascript        "access plus 1 month"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
</IfModule>

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ---- Block dotfiles (.git, .htaccess, .DS_Store, .gitignore) ----
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---- Block source-control + system junk explicitly ----
RedirectMatch 404 /\.git
RedirectMatch 404 /\.DS_Store

# ---- Disable directory listing ----
Options -Indexes

# ---- UTF-8 default ----
AddDefaultCharset UTF-8
